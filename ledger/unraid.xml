<?xml version="1.0"?>
<Container version="2">
  <Name>Ledger</Name>
  <Repository>editter/ledger:latest</Repository>
  <Registry>https://hub.docker.com/</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/editter/unraid-assets</Support>
  <Project>https://github.com/editter/unraid-assets</Project>
  <Overview>
  Provided As-is, without warranty of any kind. Use at your own risk. This container is intended for personal use and is not officially supported by Ledger or any other organization.
Ledger full-stack container.
- UI served at /
- API served at /api
- SQLite DB, healthchecks DB, and backups persisted under /data
  </Overview>
  <Category>Productivity:</Category>
  <WebUI>http://[IP]:[PORT:8080]/</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/editter/unraid-assets/main/ledger/unraid.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/editter/unraid-assets/main/ledger/ledger-icon.svg</Icon>

  <Config Name="Web UI Port" Target="8080" Default="8080" Mode="tcp" Description="HTTP port for Ledger" Type="Port" Display="always" Required="true" Mask="false">8080</Config>

  <Config Name="App Data Path" Target="/data" Default="/mnt/user/appdata/ledger" Mode="rw" Description="Persistent data folder for SQLite DB and backups" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/ledger</Config>

  <Config Name="ASPNETCORE_URLS" Target="ASPNETCORE_URLS" Default="http://+:8080" Mode="" Description="Kestrel bind URL" Type="Variable" Display="advanced" Required="true" Mask="false">http://+:8080</Config>
  <Config Name="ASPNETCORE_ENVIRONMENT" Target="ASPNETCORE_ENVIRONMENT" Default="Production" Mode="" Description="ASP.NET Core environment" Type="Variable" Display="advanced" Required="true" Mask="false">Production</Config>
  <Config Name="Health Checks Endpoint" Target="HealthChecks__Endpoint" Default="http://127.0.0.1:8080/healthz" Mode="" Description="Internal URL used by the health checks dashboard to poll this container" Type="Variable" Display="advanced" Required="true" Mask="false">http://127.0.0.1:8080/healthz</Config>
  <Config Name="Main DB Connection" Target="ConnectionStrings__Default" Default="Data Source=/data/ledger.db" Mode="" Description="SQLite connection string for main app database" Type="Variable" Display="advanced" Required="true" Mask="false">Data Source=/data/ledger.db</Config>
  <Config Name="HealthChecks DB Connection" Target="ConnectionStrings__HealthChecks" Default="Data Source=/data/healthchecks.db" Mode="" Description="SQLite connection string for health checks UI storage" Type="Variable" Display="advanced" Required="true" Mask="false">Data Source=/data/healthchecks.db</Config>
  <Config Name="Backups Directory" Target="Backups__Directory" Default="/data/backups" Mode="" Description="Folder for automated SQLite backups" Type="Variable" Display="advanced" Required="true" Mask="false">/data/backups</Config>
</Container>
